        "listing_ready": "li.product-item",
        "card": "li.product-item",
        "title_link": ".product-item-link",
        "price": ".price-box.price-final_price .special-price .price",
        "reference_price": ".pretVechi .pricePrp .price"
      },
      "stock": {
        "target": ".stocky-txt",
        "rules": [
          { "status": "out_of_stock", "all": [{ "type": "class_contains", "value": "out-of-stock" }] },
          { "status": "out_of_stock", "all": [{ "type": "class_contains", "value": "sold-out" }] },
          { "status": "limited_stock", "all": [{ "type": "class_has", "value": "limited-stock" }] },
          { "status": "supplier_stock", "all": [{ "type": "class_has", "value": "supplier-stock" }] },
          { "status": "in_stock", "all": [{ "type": "class_has", "value": "in-stock" }] },
          { "status": "in_stock", "all": [{ "type": "class_has", "value": "bin-display" }] }
        ]
      },
      "seller": { "name": "Flanco", "is_marketplace": false },
      "probe_query": "laptop asus vivobook",
      "robots_review": {
        "checked_on": null,
        "note": "robots.txt is itself Cloudflare-challenge-gated and could not be read (scrape.py:1087-1091); only /catalogsearch/result/ listing pages are requested."
