      "allowed_hosts": ["www.emag.ro", "emag.ro"],
      "search_url": "https://www.emag.ro/search/{query}",
      "query_encoding": "plus",
      "fetch": "http",
      "price_format": "ro_lei",
      "sku_adapter": "emag",
      "selectors": {
        "listing_ready": null,
        "card": ".card-item",
        "title_link": ".card-v2-title",
        "price": ".product-new-price",
        "reference_price": null
      },
      "stock": {
        "target": null,
        "rules": [
          { "status": "out_of_stock", "all": [{ "type": "text_contains", "value": "stoc epuizat" }] },
          { "status": "out_of_stock", "all": [{ "type": "text_contains", "value": "indisponibil" }] },
          { "status": "limited_stock", "all": [{ "type": "attr_equals", "attr": "data-availability-id", "value": "2" }] },
          { "status": "limited_stock", "all": [{ "type": "text_contains", "value": "ultimul produs" }] },
          { "status": "in_stock", "all": [{ "type": "attr_equals", "attr": "data-availability-id", "value": "3" }] },
          { "status": "in_stock", "all": [{ "type": "text_contains", "value": "in stoc" }] }
        ]
      },
      "seller": { "name": null, "is_marketplace": null },
      "probe_query": "laptop lenovo v15",
      "robots_review": {
        "checked_on": "2026-09-06",
        "note": "robots.txt disallows /product/; only /search/ listing pages are requested (scrape.py:936-937)."
      }
    },
    {
      "id": "pcgarage",
      "display_name": "PC Garage",
      "enabled": true,
      "allowed_hosts": ["www.pcgarage.ro", "pcgarage.ro"],
      "search_url": "https://www.pcgarage.ro/cauta/?q={query}",
      "query_encoding": "plus",
      "fetch": "browser",
      "price_format": "ro_lei",
      "sku_adapter": "pcgarage",
      "selectors": {
        "listing_ready": ".product_box",
        "card": ".product_box",
        "title_link": ".product_box_name a",
        "price": ".product_box_price_container p.price",
        "reference_price": null
      },
      "stock": {
        "target": ".product_box_availability",
        "rules": [
          { "status": "out_of_stock", "all": [{ "type": "class_has", "value": "outofstock" }] },
          { "status": "supplier_stock", "all": [{ "type": "class_has", "value": "insupplierstock" }] },
          {
            "status": "limited_stock",
            "all": [
              { "type": "class_has", "value": "instock" },
              { "type": "text_contains", "value": "limitat" }
            ]
          },
          { "status": "in_stock", "all": [{ "type": "class_has", "value": "instock" }] }
        ]
      },
      "seller": { "name": "PC Garage", "is_marketplace": false },
      "probe_query": "laptop asus vivobook",
      "robots_review": {
        "checked_on": "2026-09-06",
        "note": "robots.txt disallows /detalii-produs/; only /cauta/ listing pages are requested (scrape.py:1013-1014)."
      }
    },
    {
      "id": "flanco",
      "display_name": "Flanco",
      "enabled": true,
      "allowed_hosts": ["www.flanco.ro", "flanco.ro"],
