{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Watchlist",
  "description": "Accepts the current production flat-array watchlist format and the future Watch-model object format so validation stays backward-compatible during migration.",
  "oneOf": [
    { "$ref": "#/definitions/legacyWatchlist" },
    { "$ref": "#/definitions/modernWatchlist" }
  ],
  "definitions": {
    "legacyWatchlist": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/legacyWatchItem" }
    },
    "legacyWatchItem": {
      "type": "object",
      "required": ["site", "query"],
      "properties": {
        "site": { "type": "string", "minLength": 1 },
        "query": { "type": "string", "minLength": 1 },
        "target_price": { "type": "number", "exclusiveMinimum": 0 },
        "min_drop_percent": { "type": "number", "exclusiveMinimum": 0 },
        "atl_policy": { "$ref": "#/definitions/atlPolicy" },
        "cooldown_hours": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "modernWatchlist": {
      "type": "object",
      "required": ["watches"],
      "properties": {
        "watches": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/modernWatchItem" }
        }
      },
      "additionalProperties": false
    },
    "modernWatchItem": {
      "type": "object",
      "required": ["id", "site"],
      "oneOf": [
        { "required": ["query"] },
        { "required": ["direct_url"] }
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "owner": { "type": "string", "minLength": 1 },
        "site": { "type": "string", "minLength": 1 },
        "query": { "type": "string", "minLength": 1 },
        "direct_url": { "type": "string", "format": "uri" },
        "target_price": { "type": "number", "exclusiveMinimum": 0 },
        "min_drop_percent": { "type": "number", "exclusiveMinimum": 0 },
        "drop_rule": { "type": "string", "enum": ["percentage", "absolute"] },
        "drop_threshold": { "type": "number", "exclusiveMinimum": 0 },
        "track_all_time_low": { "type": "boolean" },
        "seller_policy": { "type": "string", "enum": ["any", "trusted"] },
        "cadence_minutes": { "type": "integer", "minimum": 5, "maximum": 1440 },
        "cooldown_hours": { "type": "integer", "minimum": 1 },
        "atl_policy": { "$ref": "#/definitions/atlPolicy" },
        "enabled": { "type": "boolean" },
        "channels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["telegram", "teams", "email", "ntfy"] }
        }
      },
      "additionalProperties": false
    },
    "atlPolicy": {
      "type": "string",
      "enum": ["conservative", "off", "aggressive"]
    }
  }
}
