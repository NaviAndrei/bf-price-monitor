# T-38 (#38): copy to .env for `docker compose`. .env is git-ignored and
# excluded from the Docker build context; never commit real values.
# WARNING (#68): one bot token = one canonical runtime. GitHub Actions is
# canonical for the production bot (Black Friday). Do NOT put the production
# token/chat here: use a SEPARATE bot token and chat for Docker, or feedback
# presses on alerts sent by the other runtime are rejected as unknown_alert.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: numeric Telegram user id(s) allowed to label alerts (#37).
# Leave EMPTY if this .env shares the production bot token.
TELEGRAM_FEEDBACK_ALLOWED_USER_IDS=
# Optional: set to 1 to send one synthetic [TEST] alert and exit, to verify
# feedback buttons render end-to-end without waiting for a real price drop.
# Leave unset in normal operation.
TELEGRAM_TEST_ALERT=
# Optional: Hugging Face token for analyze.py (empty = Ollama fallback,
# which is not reachable from the container unless you add it).
HF_TOKEN=
# Optional channels (see README "Secrets").
NTFY_TOPIC=
NTFY_SERVER=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
# Scheduling
MONITOR_INTERVAL_MINUTES=120
